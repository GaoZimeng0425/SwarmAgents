{
  "name": "swarm-agents",
  "version": "1.0.0",
  "private": true,
  "description": "SwarmAgents monorepo: desktop host + browser extension + React Native client.",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run check-boundaries",
    "lint": "turbo run lint",
    "dev": "turbo run dev",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check-boundaries": "node tools/check-boundaries.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "husky": "^9.1.7",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.3.4",
  "dependencies": {
    "morphicons": "^1.7.1"
  }
}
