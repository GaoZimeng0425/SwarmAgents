{
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnPaste": false,
    "editor.formatOnSave": false
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json5]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "biome.enabled": true,
  "cSpell.words": [],
  "css.format.enable": false,
  "editor.codeActionsOnSave": {
    "source.addMissingImports": "explicit",
    "quickfix.biome.correctness.noUnusedImports": "never",
    "quickfix.biome.correctness.noUnusedVariables": "never",
    "source.action.useSortedAttributes.biome": "explicit",
    "source.action.useSortedKeys.biome": "explicit",
    "source.action.useSortedProperties.biome": "explicit",
    "source.fixAll.biome": "explicit",
    "source.fixAll.eslint": "never",
    "source.fixAll.ts": "never",
    "source.organizeImports": "never",
    "source.organizeImports.biome": "explicit"
  },
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnPaste": false,
  "editor.formatOnSave": true,
  "css.customData": [".vscode/tailwind.json"],
  "editor.formatOnSaveMode": "modificationsIfAvailable",
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 3000,
  "files.autoSaveWhenNoErrors": true,
  "liveServer.settings.port": 3000,
  "liveServer.settings.root": "apps/risk/out",
  "todo-tree.tree.showBadges": false,
  "tailwindCSS.experimental.configFile": "./packages/design/src/styles/globals.css",
  "workbench.editorAssociations": {
    "*.md": "default"
  }
}
