{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@swarm/protocol": ["../../packages/protocol/src"],
      "@swarm/protocol/*": ["../../packages/protocol/src/*"],
      "@swarm/ui": ["../../packages/ui/src"],
      "@swarm/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["entrypoints/**/*", "lib/**/*", "wxt.config.ts", "./.wxt/wxt.d.ts", "../../packages/ui/src/**/*"]
}
