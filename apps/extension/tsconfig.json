{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    // wxt >= 0.21 turns this on in its generated tsconfig; the code here was
    // written against the previous default. Re-opt-in is a separate migration.
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@swarm/protocol": ["../../packages/protocol/src"],
      "@swarm/protocol/*": ["../../packages/protocol/src/*"],
      "@swarm/ui": ["../../packages/ui/src"],
      "@swarm/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["entrypoints/**/*", "lib/**/*", "wxt.config.ts", "./.wxt/wxt.d.ts", "../../packages/ui/src/**/*"]
}
